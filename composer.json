{
    "name": "hexlet/code",
    "description": "Page Analyzer: checks web pages for SEO suitability",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Kichigin Sergey"
        }
    ],
    "autoload": {
        "psr-4": {
            "Hexlet\\Code\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hexlet\\Code\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": ">=8.3",
        "ext-pdo": "*",
        "guzzlehttp/guzzle": "^7.9",
        "nesbot/carbon": "^3.8",
        "php-di/php-di": "^7.0",
        "slim/flash": "^0.4.0",
        "slim/php-view": "^3.4",
        "slim/psr7": "^1.7",
        "slim/slim": "^4.14",
        "symfony/css-selector": "^7.2",
        "symfony/dom-crawler": "^7.2",
        "vlucas/valitron": "^1.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13"
    },
    "config": {
        "platform": {
            "php": "8.3.0"
        }
    }
}
